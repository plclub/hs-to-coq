inline mutual CSE.cse_bind
inline mutual CSE.tryForCSE
inline mutual CSE.try_for_cse
inline mutual CSE.cseCase

# Identity's Traversable instance is inferred from the shared Data.Traversable.

# These local ticks bindings are stripTicksT results, hence nil in this model.
in CSE.cseBind rewrite forall e, CoreUtils.mkTicks ticks e = e
in CSE.try_for_cse rewrite forall e, CoreUtils.mkTicks ticks e = e

# Type/coercion substitution is provided by the current CoreSubst model.
in CSE.cseExpr rename value GHC.Core.TyCo.Subst.substTyUnchecked = CoreSubst.substTyUnchecked
in CSE.cseExpr rename value GHC.Core.TyCo.Subst.substCo = CoreSubst.substCo
in CSE.cseCase rename value GHC.Core.TyCo.Subst.substTyUnchecked = CoreSubst.substTyUnchecked

# Justified by NestedRecursionHelpers.zipMapAccumL_is_mapAccumL_zip.
in CSE.cseBind rewrite forall f s xs1 xs2, Data.Traversable.mapAccumL f s (GHC.List.zip xs1 xs2) = NestedRecursionHelpers.zipMapAccumL f s xs1 xs2

# Preserve the helper's equality-or-both-panic contract.
in CSE.cse_bind rewrite forall arity in_rhs params in_body k, match Core.collectNBinders arity in_rhs with | pair params in_body => k end = NestedRecursionHelpers.collectNBinders_k arity in_rhs (fun params in_body => k)

