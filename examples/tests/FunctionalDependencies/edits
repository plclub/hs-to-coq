add FunctionalDependencies Theorem FunctionalDependencies.fd_class_shapes : True.
Proof.
  Check (@Measured : forall v a : Type, Flag v -> Type).
  Check (@Measured__Dict : Type -> Type -> Type).
  Check (@Measured__Dict_Build : forall v a : Type,
    (a -> bool) -> (a -> v) -> Measured__Dict v a).
  Check (@measure : forall (v a : Type) (super : Flag v),
    @Measured v a super -> a -> v).
  Check (@marked : forall (v a : Type) (super : Flag v),
    @Measured v a super -> a -> bool).
  Check (@Codec : forall v a : Type, Flag v -> Type).
  Check (@Build_Codec : forall (v a : Type) (super : Flag v),
    (v -> a) -> (a -> v) -> (a -> bool) -> @Codec v a super).
  Check (@encode : forall (v a : Type) (super : Flag v),
    @Codec v a super -> a -> v).
  Check (@decode : forall (v a : Type) (super : Flag v),
    @Codec v a super -> v -> a).
  Check (@encodedFlag : forall (v a : Type) (super : Flag v),
    @Codec v a super -> a -> bool).
  Fail Check Codec__Dict.
  Check (@collision : forall a b : Type, Collision a b -> a -> b -> bool).
  Fail Check Collision__Dict.
  exact I.
Qed.

add FunctionalDependencies Theorem FunctionalDependencies.cps_fd_compute :
  (FunctionalDependencies.measure (MkElement false) = Off) /\
  ((FunctionalDependencies.measure (MkElement true) = On) /\
  ((marked (MkElement false) = false) /\
  ((marked (MkElement true) = true) /\
  ((observeElement (MkElement false) = false) /\
  ((observeElement (MkElement true) = true) /\
   (inferred = true)))))).
Proof. repeat split; reflexivity. Qed.
